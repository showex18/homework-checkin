/* 打卡页样式 */
.task-info-card {
  margin-bottom: 20rpx;
}

.task-info-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.task-info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-left: 16rpx;
}

.task-info-progress {
  display: flex;
  flex-direction: column;
}

.task-info-progress .progress-bar {
  margin-bottom: 12rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
}

/* 打卡日期 */
.checkin-date {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 10rpx;
}

.date-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.date-text {
  font-size: 28rpx;
  color: #4A90D9;
  font-weight: 600;
}

/* 拍照区域 */
.photo-section {
  margin-bottom: 30rpx;
}

.photo-upload {
  background: #fff;
  border-radius: 20rpx;
  border: 4rpx dashed #ccc;
  padding: 80rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-upload:active {
  border-color: #4A90D9;
  background: #f0f7ff;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 30rpx;
  color: #4A90D9;
  font-weight: 500;
}

.upload-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 8rpx;
}

/* 照片预览 */
.photo-preview {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.preview-img {
  width: 100%;
  height: 500rpx;
  background: #f5f5f5;
}

.photo-actions {
  display: flex;
  border-top: 2rpx solid #f0f0f0;
}

.photo-action {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  border-right: 2rpx solid #f0f0f0;
}

.photo-action:last-child {
  border-right: none;
}

.photo-action.retake {
  color: #4A90D9;
}

.photo-action.remove {
  color: #f44336;
}

.photo-action:active {
  background: #f5f5f5;
}

/* 备注 */
.note-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  position: relative;
}

.note-input {
  width: 100%;
  font-size: 28rpx;
  min-height: 120rpx;
  padding: 16rpx 0;
  line-height: 1.6;
}

.note-count {
  font-size: 22rpx;
  color: #ccc;
  text-align: right;
  display: block;
}

/* 打卡按钮 */
.checkin-btn-wrap {
  padding: 20rpx 0 60rpx;
}

.btn-primary.disabled {
  opacity: 0.6;
}

/* 成功动画 */
.success-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.success-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #4CAF50;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  animation: popIn 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.success-icon {
  font-size: 80rpx;
  color: #fff;
  font-weight: 700;
}

.success-text {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
}

.success-subtext {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 12rpx;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popIn {
  0% { transform: scale(0); }
  80% { transform: scale(1.1); }
  100% { transform: scale(1); }
}
