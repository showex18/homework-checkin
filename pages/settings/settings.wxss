/* 设置页样式 */
.profile-card {
  text-align: center;
}

.profile-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90D9 0%, #6FB7E7 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  text-align: left;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.profile-grade {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.pro-badge {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.profile-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
}

.profile-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-stat .stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A90D9;
}

.profile-stat .stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 表单 */
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  width: 120rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.form-picker {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #ccc;
}

.picker-arrow {
  font-size: 24rpx;
  color: #ccc;
  margin-left: 10rpx;
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.setting-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.setting-info {
  display: flex;
  flex-direction: column;
}

.setting-name {
  font-size: 28rpx;
  color: #333;
}

.setting-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.setting-arrow {
  font-size: 24rpx;
  color: #ccc;
}

/* 分享按钮 */
.share-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  width: 100%;
  text-align: left;
}

.share-btn::after {
  border: none;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #ccc;
  display: block;
}

.footer-sub {
  font-size: 22rpx;
  color: #ddd;
  margin-top: 8rpx;
}
